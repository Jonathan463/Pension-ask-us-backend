# Copy this file to `.env` and fill in the values.
# All variables use the PENSION_ prefix and are read by pension_ask_us.config.Settings.

# --- Optional LLM (falls back to extractive generator when blank) ---
PENSION_OPENAI_API_KEY=
PENSION_OPENAI_MODEL=gpt-4o-mini

# --- Email delivery for POST /share ---
# mode: "console" prints emails to the server log (good for local demo).
#       "smtp" sends real email via the SMTP_* settings below.
PENSION_EMAIL_MODE=console

# Address that appears in the From header. For Gmail this MUST equal
# PENSION_SMTP_USERNAME or the message is rejected.
PENSION_EMAIL_FROM=

# --- SMTP (only used when PENSION_EMAIL_MODE=smtp) ---
# Gmail example:
#   host=smtp.gmail.com  port=587  use_tls=true
#   password = a 16-char Google App Password (NOT your account password).
PENSION_SMTP_HOST=smtp.gmail.com
PENSION_SMTP_PORT=587
PENSION_SMTP_USERNAME=
PENSION_SMTP_PASSWORD=
PENSION_SMTP_USE_TLS=true
